# Generate your own secret: openssl rand -hex 32  (or in Python: import secrets; secrets.token_hex(32))
JWT_SECRET_KEY=any-random-string-you-want-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
# No database configuration needed -- data is stored in backend/data_store/db.json,
# created automatically the first time the server starts.
